# ===========================================
# CRYPTO PAYMENT GATEWAY CONFIGURATION
# ===========================================

# API Configuration
# API_KEY will be auto-generated if not provided
API_KEY=your_generated_api_key_here

# ===========================================
# BLOCKCHAIN CONFIGURATION (REQUIRED)
# ===========================================

# BSC RPC URL - Use official Binance endpoints
# Mainnet: https://bsc-dataseed1.binance.org/
# Testnet: https://data-seed-prebsc-1-s1.binance.org:8545/
BSC_RPC_URL=https://bsc-dataseed1.binance.org/

# USDT Contract Address
# BSC Mainnet: 0x55d398326f99059fF775485246999027B3197955
# BSC Testnet: 0x337610d27c682E347C9cD60BD4b3b107C9d34dDd
USDT_CONTRACT_ADDRESS=0x55d398326f99059fF775485246999027B3197955

# Your BSC wallet address to receive payments (REQUIRED)
# Must be a valid 40-character hex address starting with 0x
WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ===========================================
# PAYMENT CONFIGURATION (REQUIRED)
# ===========================================

# Payment timeout in seconds (default: 1800 = 30 minutes)
PAYMENT_TIMEOUT=1800

# Minimum confirmations required (default: 3)
MIN_CONFIRMATIONS=3

# ===========================================
# WEBHOOK CONFIGURATION (OPTIONAL)
# ===========================================

# Secret for webhook signature verification
# Generate a strong random string for production
WEBHOOK_SECRET=your_webhook_secret_here

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================

# Rate limit window in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW=900000

# Maximum requests per window (default: 200)
RATE_LIMIT_MAX_REQUESTS=200

# ===========================================
# SERVER CONFIGURATION
# ===========================================

# Environment mode
# Options: development, production, sandbox
NODE_ENV=development

# Server configuration
PORT=3000
HOST=0.0.0.0

# Application version
APP_VERSION=1.0.0

# ===========================================
# CORS CONFIGURATION
# ===========================================

# Allowed origins for CORS (comma-separated)
# Use * for development, specific domains for production
ALLOWED_ORIGINS=*

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# SQLite database file path
DATABASE_URL=./crypto_payment_gateway.db

# ===========================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===========================================

# SMTP Configuration for production
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# From email address
FROM_EMAIL=noreply@cryptopayment.com

# Ethereal Email for sandbox testing
ETHEREAL_USER=ethereal.user@ethereal.email
ETHEREAL_PASS=ethereal.pass

# ===========================================
# SANDBOX MODE CONFIGURATION
# ===========================================

# Enable sandbox mode (for testing)
SANDBOX_MODE=false

# Alternative environment variable for sandbox
ENVIRONMENT=development
